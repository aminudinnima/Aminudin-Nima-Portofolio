diff --git a/styles.css b/styles.css
index 887bf80..44f530f 100644
--- a/styles.css
+++ b/styles.css
@@ -11,7 +11,9 @@ em{font-style:normal;color:inherit}
 .logo.small{width:52px}
 .nav{display:flex;gap:32px;font:500 12px var(--mono);color:#6b7280}
 .nav a:hover{color:var(--text)}
-.menu-btn{display:grid;place-items:center;justify-self:end;padding:0;width:40px;height:40px;border:1px solid rgba(17,24,39,.12);border-radius:11px;background:rgba(17,24,39,.05);color:var(--text);font-size:18px;cursor:pointer}
+.menu-btn{display:grid;place-items:center;justify-self:end;padding:0;width:40px;height:40px;border:none;background:none;color:var(--text);font-size:18px;cursor:pointer}
+.menu-btn img{width:40px;height:40px;display:block}
+.btn-icon{width:20px;height:20px;flex:none}
 .section{padding:56px 32px}
 .heading{margin-bottom:32px}
 h2{font-size:34px;line-height:36px;font-weight:800;letter-spacing:-2px;margin-bottom:16px;color:#111;width:fit-content}
@@ -22,7 +24,9 @@ h2{font-size:34px;line-height:36px;font-weight:800;letter-spacing:-2px;margin-bo
 .hero{display:flex;flex-direction:column;align-items:center;text-align:center;gap:16px;padding:72px 32px}
 h1{font-size:clamp(48px,8vw,88px);line-height:1;font-weight:800;letter-spacing:-.07em;color:#111827}
 .tagline{font-size:22px;font-weight:700;letter-spacing:-.8px;color:rgba(17,24,39,.9)}
-.quote{color:#6b7280}
+.tagline em{color:#111827}
+.hero .mono.muted{color:#6b7280;letter-spacing:.2px}
+.quote{color:#6b7280;font-weight:500;line-height:24px}
 .actions,.links{display:flex;flex-wrap:wrap;gap:14px;justify-content:center}
 .links{justify-content:flex-start;gap:16px}
 .btn{display:inline-flex;align-items:center;justify-content:center;gap:11px;min-width:210px;height:60px;padding:0 20px;border:1px solid rgba(17,24,39,.14);border-radius:11px;background:rgba(17,24,39,.04);backdrop-filter:blur(10px);font-weight:700;font-size:16px;color:rgba(17,24,39,.77);transition:.2s;box-shadow:0 15px 50px rgba(0,0,0,.08)}
